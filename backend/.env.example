# Copy this file to backend/.env and fill the blank values.
# backend/.env is ignored by Git; never commit real passwords or tokens.
#
# PowerShell:
#   Copy-Item backend/.env.example backend/.env
#
# If you run Maven from inside backend/:
#   Copy-Item .env.example .env

# ------------------------------------------------------------
# FDP backend / MySQL
# ------------------------------------------------------------
SERVER_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ------------------------------------------------------------
# Runtime execution
# ------------------------------------------------------------
# true is required when you want FDP to really execute git clone/fetch.
# On Windows this supports local Codeup pull/scan testing.
# STATIC publishing/activation still requires the Linux deployment host
# because that flow uses rsync + Nginx.
FDP_EXECUTION_ENABLED=true

FDP_WORKSPACE_ROOT=./runtime/workspaces
FDP_STATIC_ROOT=./runtime/sites
FDP_DATA_ROOT=./runtime/data
FDP_NGINX_CONFIG_FILE=./runtime/nginx/fdp.conf
FDP_PUBLIC_PORT=8090
FDP_NGINX_RELOAD_COMMAND=nginx -t && nginx -s reload

# ------------------------------------------------------------
# FS -> Codeup -> FDP STATIC catalog
# ------------------------------------------------------------
# FS already uploads final POC HTML files to this repository as:
#   <project-name>/index.html
FDP_STATIC_CODEUP_ENABLED=true
FDP_STATIC_CODEUP_GIT_URL=https://codeup.aliyun.com/6038b0d9eb45243512067136/poc-html.git
FDP_STATIC_CODEUP_BRANCH=main

# Fill these two values with your Codeup HTTPS clone username and PAT.
# Do not put the token into FDP_STATIC_CODEUP_GIT_URL.
FDP_STATIC_CODEUP_USERNAME=
FDP_STATIC_CODEUP_TOKEN=

# Local checkout will be:
#   <FDP_WORKSPACE_ROOT>/static-codeup
FDP_STATIC_CODEUP_WORKSPACE=static-codeup

# The repository root contains folders such as:
#   索通智能工厂/index.html
FDP_STATIC_CODEUP_ROOT_DIR=.

# ------------------------------------------------------------
# Reusable encrypted Source Credentials used by normal FDP projects
# ------------------------------------------------------------
# Required only when you save Codeup credentials in the FDP database.
# Generate once and keep stable, for example:
#   openssl rand -base64 32
FDP_CREDENTIAL_KEY=
