# Copy this file to backend/.env and fill the blank values.
# backend/.env is ignored by Git; never commit real passwords or tokens.
#
# PowerShell:
#   Copy-Item backend/.env.example backend/.env
#
# If you run Maven from inside backend/:
#   Copy-Item .env.example .env

# ------------------------------------------------------------
# FDP backend / MySQL
# ------------------------------------------------------------
SERVER_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Comma-separated browser origins allowed to call the FDP backend directly.
# Local example: http://localhost:5173
# Server example: http://your-server:3003
FDP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# Runtime execution
# ------------------------------------------------------------
FDP_EXECUTION_ENABLED=true

FDP_WORKSPACE_ROOT=./runtime/workspaces
FDP_STATIC_ROOT=./runtime/sites
FDP_DATA_ROOT=./runtime/data
# Pipeline/Packages delivery bundles are cached here by project/version.
# Linux server example: /data/fdp/artifacts
FDP_ARTIFACT_ROOT=./runtime/artifacts
FDP_NGINX_CONFIG_FILE=./runtime/nginx/fdp.conf
FDP_PUBLIC_PORT=8090
FDP_NGINX_RELOAD_COMMAND=nginx -t && nginx -s reload

# ------------------------------------------------------------
# FS -> Codeup -> FDP STATIC catalog
# ------------------------------------------------------------
FDP_STATIC_CODEUP_ENABLED=true
FDP_STATIC_CODEUP_GIT_URL=https://codeup.aliyun.com/6038b0d9eb45243512067136/poc-html.git
FDP_STATIC_CODEUP_BRANCH=main
FDP_STATIC_CODEUP_USERNAME=
FDP_STATIC_CODEUP_TOKEN=
FDP_STATIC_CODEUP_WORKSPACE=static-codeup
FDP_STATIC_CODEUP_ROOT_DIR=.

# ------------------------------------------------------------
# Yunxiao Flow / Packages (formal project CI artifact source)
# ------------------------------------------------------------
# FDP reads successful Flow runs and deploys their Packages artifacts on Linux.
# Flow remains responsible for build/test/docker build/package upload.
# Center edition service endpoint is openapi-rdc.aliyuncs.com.
FDP_YUNXIAO_ENABLED=true
FDP_YUNXIAO_DOMAIN=openapi-rdc.aliyuncs.com

# Your Yunxiao organization id. For the current Codeup organization it is expected to be:
FDP_YUNXIAO_ORGANIZATION_ID=6038b0d9eb45243512067136

# Leave blank to reuse FDP_STATIC_CODEUP_TOKEN.
# The PAT must have read permission for Flow pipelines and Packages artifacts.
FDP_YUNXIAO_TOKEN=
FDP_YUNXIAO_PAGE_SIZE=30

# ------------------------------------------------------------
# Reusable encrypted Source Credentials used by normal FDP projects
# ------------------------------------------------------------
# Required only when you save Codeup credentials in the FDP database.
# Generate once and keep stable, for example:
#   openssl rand -base64 32
FDP_CREDENTIAL_KEY=
