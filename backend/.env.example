# Copy to backend/.env. Real credentials are ignored by Git.

SERVER_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Enable real Git / rsync / nginx / Docker execution on the Linux server.
FDP_EXECUTION_ENABLED=true
FDP_WORKSPACE_ROOT=./runtime/workspaces
FDP_STATIC_ROOT=./runtime/sites
FDP_DATA_ROOT=./runtime/data
FDP_NGINX_CONFIG_FILE=./runtime/nginx/fdp.conf
FDP_PUBLIC_PORT=8090
FDP_NGINX_RELOAD_COMMAND=nginx -t && nginx -s reload

# Fixed Codeup repository used for STATIC preview discovery.
# The repository root should contain one directory per project, each with index.html.
FDP_STATIC_CODEUP_ENABLED=true
FDP_STATIC_CODEUP_GIT_URL=https://codeup.aliyun.com/<organization>/poc-html.git
FDP_STATIC_CODEUP_BRANCH=main
FDP_STATIC_CODEUP_USERNAME=
FDP_STATIC_CODEUP_TOKEN=
FDP_STATIC_CODEUP_WORKSPACE=static-codeup
FDP_STATIC_CODEUP_ROOT_DIR=.

# Existing encrypted Source Credential support used by CONTAINER projects.
FDP_CREDENTIAL_KEY=
